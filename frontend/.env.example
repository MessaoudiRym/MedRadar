# Copy to .env.local for development. In production (Vercel), set the same
# names in Project > Settings > Environment Variables. NEXT_PUBLIC_* values are
# read at build time and are PUBLIC: never put a real secret here.

# URL of the MedRadar API, without / at the end
NEXT_PUBLIC_API_URL=http://localhost:8000

# Address of this site, for link previews (Open Graph). Optional on Vercel,
# which gives its own address at build time.
NEXT_PUBLIC_SITE_URL=

# Demo pharmacist account shown on /demo, with a "log in in one click" button.
# A FICTIONAL demo account only (pharmacien1@medradar.demo...), never a real one.
# Empty = the account is not shown.
NEXT_PUBLIC_DEMO_PHARMACIST_EMAIL=
NEXT_PUBLIC_DEMO_PHARMACIST_PASSWORD=

# Links shown on /demo (empty = link hidden)
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_VIDEO_URL=
