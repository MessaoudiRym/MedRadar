# Copy this file to .env and replace every value. Never commit .env.

# Database: SQLite for development (relative path = from the project root),
# PostgreSQL in production: paste the Neon URL as is (the DIRECT one, without
# "-pooler"), e.g. postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Never put the production URL in this local file: see docs/deployment.md.
DATABASE_URL=sqlite:///backend/medradar.db

# Key that signs login tokens: at least 32 random characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret

# Admin account, created by scripts/create_admin.py.
# Production: a DIFFERENT password from this local one (same for JWT_SECRET).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me-8-chars-min-1

# Password of the demo pharmacist accounts (pharmacien1@medradar.demo ...)
DEMO_PHARMACIST_PASSWORD=replace-me-demo-1

# Production frontend URL allowed by CORS, without / at the end; several are
# separated by commas (http://localhost:3000 is always allowed)
FRONTEND_URL=

# Google Gemini, for the optional AI features: photo of a medicine box, delivery note
# scan and multilingual search (empty key = these features off, the rest works).
# Free key from Google AI Studio: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_API_KEY=
# Free tier Flash model; leave empty for the default (gemini-3.8-flash)
LLM_MODEL=
# Free model tried once when the main one is overloaded; empty = gemini-3.5-flash-lite, "none" = off
LLM_FALLBACK_MODEL=

# Multilingual search: when the language model helps to understand a validated search.
#   llm_first:   Arabic, Darija, arabizi and English queries, and unsure French ones
#   rules_first: only when the normal search and the transliteration rules are unsure
ARABIC_SEARCH_MODE=llm_first
# Model that understands search queries; empty = gemini-3.5-flash-lite (fast, larger free quota)
LLM_SEARCH_MODEL=

# Delivery note history kept by pharmacists: photos, then the notes themselves,
# are deleted automatically after these durations
HISTORY_PHOTO_RETENTION_DAYS=90
HISTORY_RETENTION_MONTHS=24

# Optional: another cleaned medicines file (default data/clean/medicaments.csv)
# MEDICINES_CSV=

# Alert emails, sent with Brevo (free: 300 a day). Empty = alerts off (the form is hidden).
# The sender must be verified in Brevo: Senders, domains & dedicated IPs > Senders
EMAIL_API_KEY=
EMAIL_FROM=
# Name shown as the sender; empty = MedRadar
EMAIL_FROM_NAME=
