# Copy this file to .env and replace every value. Never commit .env.

# Database: SQLite for development (relative path = from the project root),
# PostgreSQL in production, e.g. postgresql+psycopg://user:password@host:5432/medradar
DATABASE_URL=sqlite:///backend/medradar.db

# Key that signs login tokens: at least 32 random characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret

# Admin account, created by scripts/create_admin.py
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me-8-chars-min-1

# Password of the demo pharmacist accounts (pharmacien1@medradar.demo ...)
DEMO_PHARMACIST_PASSWORD=replace-me-demo-1

# Production frontend URL allowed by CORS (http://localhost:3000 is always allowed)
FRONTEND_URL=

# Photo recognition: a vision model reads the medicine box (empty key = feature off).
# Free key from Google AI Studio: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_API_KEY=
# Free tier Flash model; leave empty for the default (gemini-3.8-flash)
LLM_MODEL=
# Free model tried once when the main one is overloaded; empty = gemini-3.5-flash-lite, "none" = off
LLM_FALLBACK_MODEL=

# Multilingual search: when the language model helps to understand a validated search.
#   llm_first:   Arabic, Darija, arabizi and English queries, and unsure French ones
#   rules_first: only when the normal search and the transliteration rules are unsure
ARABIC_SEARCH_MODE=llm_first

# Email service for alerts (later step)
EMAIL_API_KEY=your-email-service-key
